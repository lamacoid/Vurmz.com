{
  "name": "vurmz-website",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static --project-name=vurmz-website --commit-dirty=true",
    "pages:preview": "npm run pages:build && wrangler pages dev .vercel/output/static",
    "db:migrate:local": "wrangler d1 migrations apply vurmz-core --local",
    "db:migrate:remote": "wrangler d1 migrations apply vurmz-core --remote",
    "db:list:local": "wrangler d1 migrations list vurmz-core --local",
    "db:list:remote": "wrangler d1 migrations list vurmz-core --remote",
    "db:seed:local": "tsx scripts/seed.ts --local",
    "db:seed:remote": "tsx scripts/seed.ts --remote",
    "db:tables": "wrangler d1 execute vurmz-core --local --command=\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\"",
    "db:backup": "bash scripts/db-backup.sh",
    "db:cleanup": "tsx scripts/db-cleanup.ts",
    "db:types": "tsx scripts/gen-db-types.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.26.2",
    "konva": "^10.3.0",
    "leaflet": "^1.9.4",
    "next": "15.5.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-konva": "^19.2.5",
    "swr": "^2.4.1",
    "three": "^0.183.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20260118.0",
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
